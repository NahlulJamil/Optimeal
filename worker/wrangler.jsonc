{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "optimeal-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  // Alamat publik yang dipanggil aplikasi: https://optimeal-ai.optimeal.workers.dev
  "workers_dev": true,
  // Preview URL per versi tidak dipakai; matikan agar hanya satu alamat aktif.
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "optimeal-firebase",
    "GEMINI_MODEL": "gemini-3.8-flash"
  }
}
